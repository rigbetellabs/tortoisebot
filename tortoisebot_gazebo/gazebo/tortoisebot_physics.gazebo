<?xml version="1.0" ?>
<robot name="tortoisebot" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<!--  ##########  WHEEL FRICTION  ##########  -->

<gazebo reference="wheel_left">
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <kp>1000000.0</kp>
  <kd>100.0</kd>
  <minDepth>0.001</minDepth>
  <fdir1>1 0 0</fdir1>
</gazebo>

<gazebo reference="wheel_right">
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <kp>1000000.0</kp>
  <kd>100.0</kd>
  <minDepth>0.001</minDepth>
  <fdir1>1 0 0</fdir1>
</gazebo>

<!--  ##########  CASTER FRICTION  ##########  -->

<gazebo reference="castor_wheel">
  <mu1>0.0</mu1>
  <mu2>0.0</mu2>
</gazebo>

<!--  ##########  STANDARD FRICTION  ##########  -->

<gazebo reference="base_link">
  <mu1>0.0</mu1>
  <mu2>0.0</mu2>
  <gravity>true</gravity>
</gazebo>



<gazebo reference="lidar">
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
</gazebo>

<gazebo reference="camera_link">
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
</gazebo>

<gazebo reference="camera_holder">
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
</gazebo>

</robot>
