<?xml version="1.0" ?>
<robot name="tortoisebot" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<!--  ##########  WHEEL FRICTION  ##########  -->

<gazebo reference="wheel_left">
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <kp>50000.0</kp>
  <kd>10.0</kd>
  <minDepth>0.001</minDepth>
  <fdir1>1 0 0</fdir1>
</gazebo>

<gazebo reference="wheel_right">
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
  <kp>50000.0</kp>
  <kd>10.0</kd>
  <minDepth>0.001</minDepth>
  <fdir1>1 0 0</fdir1>
</gazebo>

<!--  ##########  CASTER FRICTION  ##########  -->

<gazebo reference="castor_wheel">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
    <surface>
      <friction>
        <ode>
          <mu>0.8</mu>
          <mu2>0.8</mu2>
          <!-- Reduce slip for better stopping power -->
          <slip1>0.01</slip1>
          <slip2>0.01</slip2>
          <fdir1>1 0 0</fdir1>
        </ode>
      </friction>
      <contact>
        <ode>
          <!-- Stiffer contact for immediate stopping -->
          <soft_cfm>0.001</soft_cfm>
          <soft_erp>0.8</soft_erp>
          <kp>100000</kp>
          <kd>10</kd>
          <max_vel>0.1</max_vel>
          <min_depth>0.0001</min_depth>
        </ode>
      </contact>
    </surface>
    
</gazebo>

<!--  ##########  STANDARD FRICTION  ##########  -->

<gazebo reference="base_link">
  <mu1>0.0</mu1>
  <mu2>0.0</mu2>
  <gravity>true</gravity>
</gazebo>



<gazebo reference="lidar">
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
</gazebo>

<gazebo reference="camera_link">
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
</gazebo>

<gazebo reference="camera_holder">
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
</gazebo>

</robot>
